# Fill these locally. Never paste the API key into chat or commit .env.
NEBIUS_API_KEY=
NEBIUS_MODEL=
# Enable only after checking account billing and agreeing a usage budget.
NEBIUS_ALLOW_LIVE=false

# Integrated browser app: Google OAuth is optional. Keep secrets in .env only.
# Redirect URI: http://127.0.0.1:8780/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=false
# Optional: otherwise a signing key is created in ignored local_results/.
WEB_SESSION_SECRET=

# Optional audio/video transcription: an OpenAI-compatible HTTPS endpoint.
# This separate service is NOT covered by the Nebius $2 text-inference meter.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_ALLOW_PAID=false
