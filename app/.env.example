# Fill these locally. Never paste the API key into chat or commit .env.
NEBIUS_API_KEY=
NEBIUS_MODEL=
# Enable only after checking account billing and agreeing a usage budget.
NEBIUS_ALLOW_LIVE=false

# Integrated browser app: Google OAuth is optional. Keep secrets in .env only.
# Redirect URI: http://127.0.0.1:8780/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=false

NEBIUS_MODEL_STRONG=
NEBIUS_BUDGET_USD=
NEBIUS_ENABLE_THINKING=false